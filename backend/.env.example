# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model Configuration
MODEL_DIR=models
CHECKPOINT_NAME=cgan_generator.pt
TRANSFORMER_NAME=transformer.joblib
DEVICE=auto

# Dataset Configuration (Optional - benchmark credit card fraud dataset)
DATASET_PATH=data/creditcard.csv

# Generation Configuration
MAX_GENERATION_ROWS=50000
DEFAULT_GENERATION_ROWS=1000
DEFAULT_FRAUD_PERCENTAGE=5.0
